{
  "name": "tripticks",
  "version": "1.0.0",
  "description": "Sistema de reservacion de viajes (Express.js + Supabase) bajo arquitectura MVC.",
  "main": "server.js",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "css": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --watch",
    "css:build": "tailwindcss -i ./public/css/input.css -o ./public/css/output.css --minify",
    "test": "jest"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testMatch": [
      "<rootDir>/tests/**/*.test.js"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mellyeat/Tripticks.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/mellyeat/Tripticks/issues"
  },
  "homepage": "https://github.com/mellyeat/Tripticks#readme",
  "dependencies": {
    "@supabase/supabase-js": "^2.111.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.11.0",
    "pug": "^3.0.4"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.3.3"
  }
}
