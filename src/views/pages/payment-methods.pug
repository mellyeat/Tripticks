extends ../layouts/base.pug

block variables
  - var titulo = 'Metodos de pago - TripTicks'
  - var descripcion = 'Administra tus metodos de pago en TripTicks.'
  - var clasesBody = 'bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex flex-col'
  - var noIndexar = true

block contenido
  +encabezado("perfil")
  main(class="shell grow pt-32 pb-16 w-full flex flex-col md:flex-row gap-gutter")
    +menuCuenta("pagos")
    div(class="grow space-y-12")
      div
        h1(class="font-headline-md text-headline-md text-deep-teal") Metodos de pago
        p(class="text-on-surface-variant mt-2") Administra tus tarjetas y cuentas de pago.
      //-
        El sistema no procesa cobros: RF-08 solo registra la
        reservacion y descuenta un lugar. Esta pantalla acompana a la
        simulacion de pago del checkout, por eso nada se guarda.
      section(aria-labelledby="tarjetas-titulo")
        h2#tarjetas-titulo(class="font-headline-sm text-headline-sm text-deep-teal mb-6") Tarjetas guardadas
        div(class="grid grid-cols-1 lg:grid-cols-2 gap-gutter")
          p(class="lg:col-span-2 font-body-md text-body-md text-on-surface-variant") No tienes ninguna tarjeta guardada.
          button#add-card-btn(type="button", class="rounded-xl border-2 border-dashed border-outline-variant bg-surface-container-low/50 p-10 flex flex-col items-center justify-center gap-3 min-h-[180px] text-on-surface-variant hover:border-deep-teal hover:text-deep-teal hover:bg-surface-container-low transition-colors")
            | #[span(class="material-symbols-outlined text-[32px]", aria-hidden="true") add_circle] #[span(class="font-body-md text-body-md") Agregar nueva tarjeta]
  //-
    Alta de tarjeta - MAQUETA VISUAL
    Igual que en el checkout, los campos NO llevan atributo "name"
    para que sea imposible serializarlos y enviarlos al servidor.
  dialog#add-card-dialog(class="rounded-xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm max-w-md w-[calc(100%-2rem)]")
    form(method="dialog", class="bg-surface-container-lowest p-6 md:p-8")
      h2(class="font-headline-sm text-headline-sm text-primary mb-3") Agregar tarjeta
      div(class="space-y-4 mb-8")
        div
          label(for="nueva-card-number", class="field-label") NUMERO DE TARJETA
          input#nueva-card-number(type="text", inputmode="numeric", autocomplete="off", maxlength="12", pattern="[0-9]{12}", placeholder="000000000000", class="field")
        div(class="grid grid-cols-2 gap-4")
          div
            label(for="nueva-card-exp", class="field-label") FECHA EXP.
            input#nueva-card-exp(type="date", autocomplete="off", class="field")
          div
            label(for="nueva-card-cvc", class="field-label") CVC
            input#nueva-card-cvc(type="text", inputmode="numeric", autocomplete="off", placeholder="123", class="field")
        div
          label(for="nueva-card-name", class="field-label") NOMBRE EN LA TARJETA
          input#nueva-card-name(type="text", autocomplete="off", placeholder="Como aparece en la tarjeta", class="field")
      div(class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3")
        button(type="submit", value="cancel", class="btn-ghost") Cancelar
        button(type="submit", value="save", class="btn-primary") Guardar tarjeta
  +piePagina()
