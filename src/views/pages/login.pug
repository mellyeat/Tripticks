extends ../layouts/base.pug

block variables
  - var titulo = 'Iniciar sesion - TripTicks'
  - var descripcion = 'Inicia sesion en TripTicks para gestionar tus reservaciones de viaje.'
  - var clasesBody = 'bg-off-white text-on-surface font-body-md text-body-md antialiased'
  - var scriptsVista = ['/js/auth.js']

block contenido
  main(class="min-h-screen flex")
    //-
      Columna del formulario. Ocupa el ancho completo hasta lg; a partir
      de ahi cede la mitad derecha a la fotografia.
    section(class="flex-1 flex flex-col justify-center px-margin-mobile md:px-margin-desktop py-12 lg:flex-none lg:w-1/2 lg:px-20 xl:px-24")
      div(class="w-full max-w-sm mx-auto lg:w-96 animate-fade-up")
        div(class="mb-10 text-center lg:text-left")
          a(href="/", class="font-display-lg text-display-lg-mobile text-deep-teal tracking-tight inline-block hover:opacity-90 transition-opacity") TripTicks
        h1(class="font-headline-md text-headline-md text-deep-teal") Bienvenido de nuevo
        p(class="font-body-md text-body-md text-on-surface-variant mt-2") Continua tu viaje hacia la aventura sofisticada.
        div#form-alert(class="alert-error hidden mt-8", role="alert")
        form#login-form(novalidate, class="space-y-6 mt-8")
          div
            label(for="email", class="field-label") CORREO ELECTRONICO
            div(class="relative")
              span(class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-warm-gray text-xl", aria-hidden="true") mail
              input#email(type="email", name="email", class="field field-icon", placeholder="tucorreo@ejemplo.com", autocomplete="email", required)
            p(class="font-body-sm text-body-sm text-error mt-2 hidden", data-error="email")
          div
            label(for="password", class="field-label") CONTRASENA
            div(class="relative")
              span(class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-warm-gray text-xl", aria-hidden="true") lock
              input#password(type="password", name="password", class="field field-icon pr-12", placeholder="Tu contrasena", autocomplete="current-password", required)
              button(type="button", data-toggle-password="password", class="absolute right-3 top-1/2 -translate-y-1/2 text-warm-gray hover:text-deep-teal p-1 rounded", aria-label="Mostrar contrasena")
                span(class="material-symbols-outlined text-xl", aria-hidden="true") visibility
            p(class="font-body-sm text-body-sm text-error mt-2 hidden", data-error="password")
          //- La recuperacion de contrasena tampoco tiene endpoint todavia.
          div(class="flex justify-end")
            button(type="button", class="btn-link-quiet", disabled, title="Disponible proximamente") Olvidaste tu contrasena?
          button(type="submit", class="btn-primary w-full") Iniciar sesion
        p(class="font-body-sm text-body-sm text-on-surface-variant mt-8 text-center")
          a(href="/register", class="text-deep-teal hover:text-primary hover:underline transition-all") No tengo una cuenta. Registrarme
    //-
      Fotografia de apoyo. Es decorativa: no aporta informacion que no
      este ya en el texto, por eso se oculta a los lectores de pantalla.
    section(class="hidden lg:block lg:w-1/2 relative bg-warm-sand", aria-hidden="true")
      div(class="absolute inset-0 bg-cover bg-center", style="background-image: url('https://images.unsplash.com/photo-1688229394127-4aca1b1d13d8?auto=format&fit=crop&q=85&w=2000')")
      div(class="absolute inset-0 bg-gradient-to-br from-tertiary/20 to-surface/10")
