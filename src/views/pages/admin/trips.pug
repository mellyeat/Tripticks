extends ../../layouts/base.pug

block variables
  - var titulo = 'Gestion de viajes - TripTicks'
  - var descripcion = 'Administracion del catalogo de viajes de TripTicks.'
  - var clasesBody = 'bg-off-white text-on-surface font-body-md text-body-md antialiased min-h-screen'
  - var scriptsVista = ['/js/admin/trips.js']

block contenido
  +consolaAdmin("viajes")
  main(class="md:ml-64 flex flex-col min-h-screen")
    +barraAdmin()
    div(class="flex-1 p-margin-mobile md:p-margin-desktop space-y-8")
      section(class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4")
        div
          h1(class="font-headline-md text-headline-md text-deep-teal mb-2") Gestion de viajes
          p(class="font-body-lg text-body-lg text-warm-gray") Administra el catalogo de experiencias y destinos.
        a(href="/admin/trips/new", class="btn-primary w-full md:w-auto")
          | #[span(class="material-symbols-outlined text-xl", aria-hidden="true") add_circle] Crear nuevo viaje

      div#trips-error(class="hidden alert-error", role="alert")
        | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#trips-error-message]

      div#trips-success(class="hidden alert-success", role="status")
        | #[span(class="material-symbols-outlined", aria-hidden="true") check_circle] #[span#trips-success-message]

      //-
        Las cuatro metricas se calculan sobre la pagina cargada del catalogo:
        conteo total, cuantos tienen activo = true, cuantos se quedaron sin
        cupos y cuantos tienen fecha_salida futura.
      section(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-gutter", aria-label="Resumen del catalogo")
        article(class="stat-card flex items-center gap-4")
          span(class="stat-icon bg-warm-sand text-deep-teal rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") flight_takeoff
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-1") TOTAL DE VIAJES
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="total") --
        article(class="stat-card flex items-center gap-4")
          span(class="stat-icon bg-primary-fixed/40 text-deep-teal rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") verified
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-1") VIAJES ACTIVOS
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="activos") --
        article(class="stat-card flex items-center gap-4")
          span(class="stat-icon bg-soft-terracota/20 text-soft-terracota rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") event_busy
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-1") SIN CUPOS
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="agotados") --
        article(class="stat-card flex items-center gap-4")
          span(class="stat-icon bg-secondary-container/40 text-secondary rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") event_upcoming
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-1") PROXIMAS SALIDAS
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="proximas") --

      section(class="card", aria-labelledby="catalogo-titulo")
        h2#catalogo-titulo(class="sr-only") Catalogo de viajes

        //-
          El mockup traia un filtro de "Categoria", pero la tabla "viajes" no
          tiene esa columna; se sustituye por el de estado, que si se resuelve
          con activo y cupos_disponibles.
        div(class="p-6 flex flex-col md:flex-row justify-between gap-4 border-b border-outline-variant/30")
          div(class="flex flex-col sm:flex-row gap-4")
            div
              label(for="filtro-destino", class="sr-only") Filtrar por destino
              input#filtro-destino(type="search", class="field py-2", placeholder="Buscar por destino", autocomplete="off")
            div(class="relative")
              label(for="filtro-estado-viaje", class="sr-only") Filtrar por estado
              select#filtro-estado-viaje(class="field-select")
                option(value) Todos los estados
                option(value="disponible") Disponible
                option(value="agotado") Agotado
                option(value="inactivo") Inactivo
              span(class="field-select-icon")
                span(class="material-symbols-outlined", aria-hidden="true") expand_more
          div(class="flex gap-2")
            button#refrescar(type="button", class="icon-btn", aria-label="Actualizar catalogo")
              span(class="material-symbols-outlined", aria-hidden="true") refresh

        div(class="overflow-x-auto")
          table(class="w-full border-collapse")
            thead
              tr(class="bg-surface-container-low border-b border-outline-variant/30")
                th(scope="col", class="admin-th") Viaje
                th(scope="col", class="admin-th") Destino
                th(scope="col", class="admin-th hidden sm:table-cell") Cupos
                th(scope="col", class="admin-th") Precio
                th(scope="col", class="admin-th") Estado
                th(scope="col", class="admin-th text-right") Acciones
            tbody#trips-body(class="divide-y divide-outline-variant/20")

        p#trips-loading(class="text-center py-12 font-body-md text-body-md text-warm-gray") Cargando el catalogo...
        p#trips-empty(class="hidden text-center py-12 font-body-md text-body-md text-warm-gray")
          | No hay viajes que coincidan con el filtro.

        div(class="p-6 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-outline-variant/30 bg-surface-container-low/50")
          p#trips-count(class="font-body-sm text-body-sm text-warm-gray")
          nav#trips-pagination(class="flex items-center gap-2", aria-label="Paginacion de viajes")

  template#trip-row-template
    tr(class="admin-row")
      td(class="admin-td")
        div(class="flex items-center gap-4")
          img(class="w-20 h-14 rounded-lg object-cover shrink-0", loading="lazy", data-cell="imagen", alt="")
          div(class="min-w-0")
            a(class="font-semibold text-deep-teal hover:underline", data-cell="titulo")
            p(class="text-warm-gray text-xs", data-cell="duracion")
      td(class="admin-td text-warm-gray", data-cell="destino")
      td(class="admin-td text-warm-gray hidden sm:table-cell", data-cell="cupos")
      td(class="admin-td font-medium text-on-surface", data-cell="precio")
      td(class="admin-td")
        span(data-cell="estado")
      td(class="admin-td text-right")
        div(class="flex items-center justify-end gap-1")
          a(class="icon-btn border-transparent shadow-none", data-cell="editar", aria-label="Editar el viaje")
            span(class="material-symbols-outlined", aria-hidden="true") edit
          button(type="button", class="icon-btn border-transparent shadow-none", data-action="alternar", aria-label="Activar o desactivar el viaje")
            span(class="material-symbols-outlined", aria-hidden="true", data-cell="icono-activo") visibility_off
          button(type="button", class="icon-btn border-transparent shadow-none text-error", data-action="eliminar", aria-label="Eliminar el viaje")
            span(class="material-symbols-outlined", aria-hidden="true") delete

  //-
    Confirmacion de borrado. El endpoint responde 409 cuando el viaje tiene
    reservaciones, asi que el dialogo tambien ofrece desactivarlo, que es la
    salida que recomienda la API en ese caso.
  dialog#delete-dialog(class="rounded-xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm max-w-md w-[calc(100%-2rem)]")
    form(method="dialog", class="bg-surface-container-lowest p-6 md:p-8")
      h2(class="font-headline-sm text-headline-sm text-primary mb-3") Eliminar viaje
      p(class="font-body-md text-body-md text-on-surface-variant mb-6")
        | Se borrara #[strong(class="text-on-surface", data-cell="titulo") este viaje] del catalogo de forma definitiva. Esta accion no se puede deshacer.

      div#delete-error(class="hidden alert-error mb-4", role="alert")
        | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#delete-error-message]

      div(class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3")
        button(type="submit", value="cancel", class="btn-ghost") Conservar
        button#desactivar-en-su-lugar(type="button", class="btn-secondary hidden") Desactivarlo
        button#confirm-delete-btn(type="button", class="btn-primary bg-error hover:bg-on-error-container") Si, eliminar
