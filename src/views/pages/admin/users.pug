extends ../../layouts/base.pug

block variables
  - var titulo = 'Gestion de usuarios - TripTicks'
  - var descripcion = 'Gestion de usuarios de TripTicks: consulta, roles y estado de las cuentas.'
  - var clasesBody = 'bg-off-white text-on-surface font-body-md text-body-md antialiased min-h-screen'
  - var scriptsVista = ['/js/admin/users.js']

block contenido
  +consolaAdmin("usuarios")
  main(class="md:ml-64 flex flex-col min-h-screen")
    +barraAdmin()
    div(class="flex-1 p-margin-mobile md:p-margin-desktop space-y-8")
      section(class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4")
        div
          h1(class="font-headline-md text-headline-md text-deep-teal mb-2") Gestion de usuarios
          p(class="font-body-lg text-body-lg text-warm-gray") Consulta las cuentas, sus roles y su estado.
        a(href="/admin/users/new", class="btn-primary w-full md:w-auto")
          | #[span(class="material-symbols-outlined text-xl", aria-hidden="true") person_add] Anadir usuario

      div#users-error(class="hidden alert-error", role="alert")
        | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#users-error-message]

      div#users-success(class="hidden alert-success", role="status")
        | #[span(class="material-symbols-outlined", aria-hidden="true") check_circle] #[span#users-success-message]

      //-
        Las tres metricas salen de columnas que si existen en la tabla
        "usuarios": el conteo total, el rol y la bandera "activo".
      section(class="grid grid-cols-1 md:grid-cols-3 gap-gutter", aria-label="Resumen de cuentas")
        article(class="stat-card flex justify-between items-center gap-4")
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-2") TOTAL DE USUARIOS
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="total") --
          span(class="stat-icon bg-deep-teal/10 text-deep-teal rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") group
        article(class="stat-card flex justify-between items-center gap-4")
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-2") CUENTAS ACTIVAS
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="activos") --
          span(class="stat-icon bg-warm-sand text-deep-teal rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") how_to_reg
        article(class="stat-card flex justify-between items-center gap-4")
          div
            p(class="font-label-caps text-label-caps text-warm-gray mb-2") ADMINISTRADORES
            p(class="font-headline-md text-headline-md font-bold text-deep-teal", data-stat="administradores") --
          span(class="stat-icon bg-soft-terracota/10 text-soft-terracota rounded-full p-3")
            span(class="material-symbols-outlined", aria-hidden="true") shield_person

      section(class="card", aria-labelledby="tabla-titulo")
        h2#tabla-titulo(class="sr-only") Listado de usuarios

        //-
          Los filtros corresponden a las columnas "rol" y "activo"; el mockup
          traia roles y estados que este sistema no maneja (Provider, Suspended).
        div(class="p-6 flex flex-col md:flex-row justify-between gap-4 border-b border-outline-variant/30")
          div(class="flex flex-col sm:flex-row gap-4")
            div
              label(for="filtro-busqueda", class="sr-only") Buscar por nombre o correo
              input#filtro-busqueda(type="search", class="field py-2", placeholder="Nombre o correo", autocomplete="off")
            div(class="relative")
              label(for="filtro-rol", class="sr-only") Filtrar por rol
              select#filtro-rol(class="field-select")
                option(value) Todos los roles
                option(value="usuario") Usuario
                option(value="administrador") Administrador
              span(class="field-select-icon")
                span(class="material-symbols-outlined", aria-hidden="true") expand_more
            div(class="relative")
              label(for="filtro-estado", class="sr-only") Filtrar por estado
              select#filtro-estado(class="field-select")
                option(value) Todos los estados
                option(value="true") Activo
                option(value="false") Inactivo
              span(class="field-select-icon")
                span(class="material-symbols-outlined", aria-hidden="true") expand_more
          div(class="flex gap-2")
            button#refrescar(type="button", class="icon-btn", aria-label="Actualizar listado")
              span(class="material-symbols-outlined", aria-hidden="true") refresh

        div(class="overflow-x-auto")
          table(class="w-full border-collapse")
            thead
              tr(class="bg-surface-container-low border-b border-outline-variant/30")
                th(scope="col", class="admin-th") Usuario
                th(scope="col", class="admin-th") Rol
                th(scope="col", class="admin-th") Estado
                th(scope="col", class="admin-th hidden sm:table-cell") Alta
                th(scope="col", class="admin-th text-right") Acciones
            tbody#users-body(class="divide-y divide-outline-variant/20")

        p#users-loading(class="text-center py-12 font-body-md text-body-md text-warm-gray") Cargando las cuentas...
        p#users-empty(class="hidden text-center py-12 font-body-md text-body-md text-warm-gray")
          | No hay cuentas que coincidan con el filtro.

        div(class="p-6 flex flex-col sm:flex-row justify-between items-center gap-4 border-t border-outline-variant/30 bg-surface-container-low/50")
          p#users-count(class="font-body-sm text-body-sm text-warm-gray")
          nav#users-pagination(class="flex items-center gap-2", aria-label="Paginacion de usuarios")

  template#user-row-template
    tr(class="admin-row")
      td(class="admin-td")
        div(class="flex items-center gap-4")
          span(class="avatar-initials", aria-hidden="true", data-cell="iniciales")
          div(class="min-w-0")
            p(class="font-semibold text-deep-teal", data-cell="nombre")
            p(class="text-warm-gray text-xs", data-cell="email")
      td(class="admin-td")
        span(data-cell="rol")
      td(class="admin-td")
        span(class="flex items-center gap-2")
          span(class="status-dot", aria-hidden="true", data-cell="punto")
          span(class="font-semibold", data-cell="estado")
      td(class="admin-td text-warm-gray hidden sm:table-cell", data-cell="alta")
      td(class="admin-td text-right")
        div(class="flex items-center justify-end gap-1")
          button(type="button", class="icon-btn border-transparent shadow-none", data-action="editar", aria-label="Editar la cuenta")
            span(class="material-symbols-outlined", aria-hidden="true") edit
          button(type="button", class="icon-btn border-transparent shadow-none text-error", data-action="desactivar", aria-label="Desactivar la cuenta")
            span(class="material-symbols-outlined", aria-hidden="true") person_off

  //-
    Edicion en linea (RF-14). Un dialogo evita una pagina aparte para cuatro
    campos, y es donde se asigna el rol.
  dialog#user-dialog(class="rounded-xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm max-w-lg w-[calc(100%-2rem)]")
    form#user-form(class="bg-surface-container-lowest p-6 md:p-8", novalidate)
      h2(class="font-headline-sm text-headline-sm text-primary mb-6") Editar cuenta

      div#user-dialog-error(class="hidden alert-error mb-6", role="alert")
        | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#user-dialog-error-message]

      div(class="space-y-4")
        div
          label(for="editar-nombre", class="field-label") NOMBRE COMPLETO
          input#editar-nombre(type="text", name="nombre", class="field", required, minlength="3", maxlength="100", autocomplete="name")
          p(class="mt-2 font-body-sm text-body-sm text-error hidden", data-error="nombre", role="alert")

        div
          label(for="editar-email", class="field-label") CORREO ELECTRONICO
          input#editar-email(type="email", name="email", class="field", required, maxlength="255", autocomplete="email")
          p(class="mt-2 font-body-sm text-body-sm text-error hidden", data-error="email", role="alert")

        div(class="grid grid-cols-1 sm:grid-cols-2 gap-4")
          div
            label(for="editar-rol", class="field-label") ROL
            div(class="relative")
              select#editar-rol(name="rol", class="field-select")
                option(value="usuario") Usuario
                option(value="administrador") Administrador
              span(class="field-select-icon")
                span(class="material-symbols-outlined", aria-hidden="true") expand_more
          div
            label(for="editar-activo", class="field-label") ESTADO
            div(class="relative")
              select#editar-activo(name="activo", class="field-select")
                option(value="true") Activo
                option(value="false") Inactivo
              span(class="field-select-icon")
                span(class="material-symbols-outlined", aria-hidden="true") expand_more

      div(class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3 mt-8")
        button#user-cancel-btn(type="button", class="btn-ghost") Cancelar
        button(type="submit", class="btn-primary") Guardar cambios

  dialog#deactivate-dialog(class="rounded-xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm max-w-md w-[calc(100%-2rem)]")
    form(method="dialog", class="bg-surface-container-lowest p-6 md:p-8")
      h2(class="font-headline-sm text-headline-sm text-primary mb-3") Desactivar cuenta
      p(class="font-body-md text-body-md text-on-surface-variant mb-6")
        | #[strong(class="text-on-surface", data-cell="nombre") Esta persona] ya no podra iniciar sesion. La cuenta y sus reservaciones se conservan, y puedes volver a activarla cuando quieras.

      div#deactivate-error(class="hidden alert-error mb-4", role="alert")
        | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#deactivate-error-message]

      div(class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3")
        button(type="submit", value="cancel", class="btn-ghost") Conservar activa
        button#confirm-deactivate-btn(type="button", class="btn-primary bg-error hover:bg-on-error-container") Si, desactivar
