extends ../layouts/base.pug

block variables
  - var titulo = 'Seguridad - TripTicks'
  - var descripcion = 'Protege tu cuenta de TripTicks y gestiona tu contrasena.'
  - var clasesBody = 'bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex flex-col'
  - var scriptsVista = ['/js/auth.js']

block contenido
  +encabezado("perfil")
  main(class="shell grow pt-32 pb-16 w-full flex flex-col md:flex-row gap-gutter")
    +menuCuenta("seguridad")
    div(class="grow space-y-12")
      div
        h1(class="font-headline-md text-headline-md text-deep-teal") Seguridad
        p(class="text-on-surface-variant mt-2") Protege tu cuenta y gestiona tu acceso.
      //-
        Cambiar contrasena
        La nueva contrasena se guarda con hash bcrypt (RNF-02) y se
        valida en el servidor antes de almacenarse (RF-19).
      section(class="panel", aria-labelledby="password-titulo")
        h2#password-titulo(class="panel-title")
          | #[span(class="material-symbols-outlined text-deep-teal", aria-hidden="true") key] Cambiar contrasena
        div#password-error(class="hidden alert-error mb-6", role="alert")
          | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#password-error-message]
        div#password-success(class="hidden alert-success mb-6", role="status")
          | #[span(class="material-symbols-outlined", aria-hidden="true") check_circle] #[span Tu contrasena se actualizo correctamente.]
        form#password-form(class="max-w-lg", novalidate)
          div(class="mb-6")
            label(for="pass-actual", class="field-label") CONTRASENA ACTUAL
            input#pass-actual(type="password", name="password_actual", class="field", autocomplete="current-password", required)
          div(class="mb-6")
            label(for="pass-nueva", class="field-label") NUEVA CONTRASENA
            input#pass-nueva(type="password", name="password_nueva", class="field", autocomplete="new-password", required, minlength="8", aria-describedby="pass-ayuda")
            p#pass-ayuda(class="mt-2 font-body-sm text-body-sm text-on-surface-variant")
              | Debe tener al menos 8 caracteres, incluyendo un numero y un simbolo.
          div(class="mb-8")
            label(for="pass-confirmar", class="field-label") CONFIRMAR NUEVA CONTRASENA
            input#pass-confirmar(type="password", name="password_confirmar", class="field", autocomplete="new-password", required, minlength="8")
          button(type="submit", class="btn-primary") Actualizar contrasena
      //-
        Verificacion en dos pasos
        No esta contemplada en los requerimientos y no hay backend que
        la respalde. El interruptor se deja apagado y deshabilitado a
        proposito: mostrarlo encendido afirmaria que la cuenta tiene
        una proteccion que en realidad no existe.
      section(class="panel opacity-75", aria-labelledby="dosfactores-titulo")
        h2#dosfactores-titulo(class="panel-title")
          | #[span(class="material-symbols-outlined text-deep-teal", aria-hidden="true") shield] Verificacion en dos pasos (2FA) #[span(class="chip-alert ml-auto") No disponible]
        div(class="flex items-start justify-between gap-6")
          p(class="font-body-md text-body-md text-on-surface-variant max-w-2xl")
            | Anadiria una capa adicional de seguridad solicitando un codigo unico al iniciar sesion desde un dispositivo nuevo. Esta funcion no forma parte del alcance del sistema, por lo que permanece desactivada.
          label(class="relative inline-flex items-center shrink-0 cursor-not-allowed")
            input(type="checkbox", class="sr-only peer", disabled)
            | #[span(class="w-14 h-8 rounded-full bg-surface-variant peer-checked:bg-primary transition-colors after:content-[''] after:absolute after:top-1 after:left-1 after:w-6 after:h-6 after:rounded-full after:bg-surface-container-lowest after:shadow-sm after:transition-transform peer-checked:after:translate-x-6")] #[span(class="sr-only") Activar verificacion en dos pasos]
      //-
        Sesion actual
        El diseno original listaba varios dispositivos con su ubicacion
        y permitia cerrarlos de forma remota. Con JWT sin estado
        (RNF-03) el servidor no lleva registro de sesiones abiertas, asi
        que solo se puede mostrar y cerrar la sesion de este navegador.
      section(class="panel", aria-labelledby="sesion-titulo")
        h2#sesion-titulo(class="panel-title")
          | #[span(class="material-symbols-outlined text-deep-teal", aria-hidden="true") devices] Sesion actual
        div(class="flex items-center gap-4 p-4 rounded-lg bg-surface-container-low mb-6")
          span(class="material-symbols-outlined text-on-surface-variant", aria-hidden="true") computer
          div(class="grow")
            p(class="font-body-md text-body-md text-on-surface font-semibold flex items-center gap-2 flex-wrap")
              | Este dispositivo #[span(class="chip") ACTIVO]
            p(class="font-body-sm text-body-sm text-on-surface-variant", data-session="navegador") Navegador actual
          button#logout-session-btn(type="button", class="link-danger") Cerrar sesion
        p(class="font-body-sm text-body-sm text-on-surface-variant flex items-start gap-2")
          | #[span(class="material-symbols-outlined text-[18px] shrink-0", aria-hidden="true") info] El sistema autentica con tokens JWT sin estado, por lo que no lleva un registro de las sesiones abiertas en otros dispositivos. Para listarlas y cerrarlas de forma remota haria falta una tabla de sesiones en la base de datos.
  +piePagina()
