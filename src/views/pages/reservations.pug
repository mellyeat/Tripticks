extends ../layouts/base.pug

block variables
  - var titulo = 'Mis reservaciones - TripTicks'
  - var descripcion = 'Consulta y gestiona tus reservaciones en TripTicks.'
  - var clasesBody = 'bg-background text-on-surface font-body-md text-body-md antialiased min-h-screen flex flex-col'
  - var scriptsVista = ['/js/reservations.js']

block contenido
  +encabezado("reservaciones")
  main(class="shell grow pt-32 pb-24 w-full")
    div(class="mb-12")
      h1(class="font-headline-md text-headline-md text-on-surface mb-4") Mis reservaciones
      p(class="font-body-lg text-body-lg text-on-surface-variant")
        | Revisa y gestiona tus proximas aventuras y tus viajes pasados.
    div(class="flex border-b border-outline-variant mb-12 gap-8 overflow-x-auto", role="tablist", aria-label="Filtrar reservaciones por estado")
      button(type="button", class="tab-active shrink-0", role="tab", aria-selected="true", data-filter="proximas") PROXIMAS
      button(type="button", class="tab shrink-0", role="tab", aria-selected="false", data-filter="pasadas") PASADAS
      button(type="button", class="tab shrink-0", role="tab", aria-selected="false", data-filter="canceladas") CANCELADAS
    div#reservations-loading(class="hidden grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter", aria-hidden="true")
      div(class="card")
        div(class="skeleton h-48 rounded-none")
        div(class="p-6 space-y-3")
          div(class="skeleton h-6 w-3/4")
          div(class="skeleton h-4 w-1/2")
          div(class="skeleton h-12 w-full")
      div(class="card")
        div(class="skeleton h-48 rounded-none")
        div(class="p-6 space-y-3")
          div(class="skeleton h-6 w-3/4")
          div(class="skeleton h-4 w-1/2")
          div(class="skeleton h-12 w-full")
      div(class="card")
        div(class="skeleton h-48 rounded-none")
        div(class="p-6 space-y-3")
          div(class="skeleton h-6 w-3/4")
          div(class="skeleton h-4 w-1/2")
          div(class="skeleton h-12 w-full")
    div#reservations-error(class="hidden alert-error", role="alert")
      | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#reservations-error-message No fue posible cargar tus reservaciones.]
    div#reservations-empty(class="hidden text-center py-20")
      span(class="material-symbols-outlined text-warm-gray text-[64px] mb-4", aria-hidden="true") luggage
      h2(class="font-headline-sm text-headline-sm text-on-surface mb-2") Todavia no tienes reservaciones
      p(class="font-body-md text-body-md text-on-surface-variant mb-6") Explora el catalogo y aparta tu lugar en el proximo viaje.
      a(href="/trips", class="btn-primary") Ver viajes disponibles
    //- Las tarjetas las arma /js/reservations.js con /api/reservations.
    div#reservations-grid(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-gutter")
  template#reservation-card-template
    article(class="card premium-card flex flex-col")
      div(class="h-48 relative")
        img(src, alt, data-reservation="imagen", class="w-full h-full object-cover")
        span(class="absolute top-4 right-4", data-reservation="estado")
      div(class="p-6 grow flex flex-col justify-between")
        div
          h2(class="font-headline-sm text-headline-sm text-on-surface mb-2", data-reservation="titulo")
          p(class="flex items-center gap-2 text-on-surface-variant font-body-sm text-body-sm mb-2")
            | #[span(class="material-symbols-outlined text-[18px]", aria-hidden="true") calendar_month] #[span(data-reservation="fechas")]
          p(class="flex items-center gap-2 text-on-surface-variant font-body-sm text-body-sm")
            | #[span(class="material-symbols-outlined text-[18px]", aria-hidden="true") confirmation_number] #[span(data-reservation="folio")]
        div(class="mt-4 pt-4 border-t border-outline-variant flex justify-between items-end gap-3")
          div
            | #[span(class="font-body-sm text-body-sm text-on-surface-variant block") Total] #[span(class="font-headline-sm text-headline-sm text-primary", data-reservation="total")]
          div(class="flex flex-col items-end gap-2")
            a(href="#", class="btn-primary px-4", data-reservation="detalle-link") Ver detalles
            button(type="button", class="link-danger", data-action="cancelar") Cancelar reserva
  dialog#cancel-dialog(class="rounded-xl p-0 backdrop:bg-primary/40 backdrop:backdrop-blur-sm max-w-md w-[calc(100%-2rem)]")
    form(method="dialog", class="bg-surface-container-lowest p-6 md:p-8")
      h2(class="font-headline-sm text-headline-sm text-primary mb-3") Cancelar reservacion
      p(class="font-body-md text-body-md text-on-surface-variant mb-6")
        | Se liberara tu lugar en #[strong(class="text-on-surface", data-reservation="titulo") este viaje] y quedara disponible para otros viajeros. Esta accion no se puede deshacer.
      div#cancel-error(class="hidden alert-error mb-4", role="alert")
        | #[span(class="material-symbols-outlined", aria-hidden="true") error] #[span#cancel-error-message]
      div(class="flex flex-col-reverse sm:flex-row sm:justify-end gap-3")
        button(type="submit", value="cancel", class="btn-ghost") Conservar reservacion
        button#confirm-cancel-btn(type="button", class="btn-primary bg-error hover:bg-on-error-container") Si, cancelar
  +piePagina()
