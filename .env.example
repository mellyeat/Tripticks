# Servidor
PORT=3000
NODE_ENV=development

# Supabase (RNF-09)
# URL y llaves del proyecto: Dashboard > Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
# La service role key salta las politicas RLS. Es secreta: nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Autenticacion (RNF-02, RNF-03)
# Cadena aleatoria larga. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=2h
BCRYPT_SALT_ROUNDS=10

# Red
# Origenes externos autorizados, separados por comas. Vacio = solo el mismo
# origen, que es lo correcto mientras la API y las vistas viajen juntas.
CORS_ORIGINS=
# Proxies de confianza delante de la aplicacion (0 = ninguno). En un despliegue
# detras de un balanceador se pone 1, o el cupo de peticiones vera una sola IP.
TRUST_PROXY=0
